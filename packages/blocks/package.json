  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!src/test-setup.ts",
    "LICENSE",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "bunchee --no-dts && tsc -p tsconfig.build.json && node ../../scripts/normalize-declarations.mjs dist",
    "dev": "bunchee --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
