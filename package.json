{
  "name": "lindaui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:declarations": "node --test scripts/normalize-declarations.test.mjs",
    "skill:test": "node --test scripts/lindaui-skill.test.mjs",
    "skill:validate": "node scripts/validate-lindaui-skill.mjs",
    "skill:index": "node scripts/build-skill-index.mjs",
    "skill:vendor": "node scripts/build-skill-vendor.mjs",
    "skill:consumers": "node scripts/verify-skill-consumers.mjs",
    "skill:sync": "node skills/lindaui/scripts/sync.mjs",
    "version-packages": "changeset version && node scripts/build-skill-index.mjs",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "gen:component": "node scripts/gen.mjs component",
    "gen:block": "node scripts/gen.mjs block",
    "gen:exports": "node scripts/gen.mjs exports",
    "pack:consumer": "node scripts/pack-consumer.mjs",
    "release": "changeset publish",
    "release:flow": "node scripts/release-flow.mjs",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:e2e:build": "turbo run storybook:build --filter=@lindaui/storybook && turbo run build --filter=verona",
    "test:e2e": "pnpm test:e2e:build && e2e run && e2e run --config e2e.verona.config.ts --output .e2e/verona",
    "test:e2e:list": "e2e list && e2e list --config e2e.verona.config.ts",
    "test:e2e:install": "e2e-web install chromium",
    "test:e2e:mcp": "e2e mcp",
    "test:e2e:typecheck": "tsc -p tests/tsconfig.json --noEmit",
    "test:coverage:gaps": "node scripts/coverage-gaps.mjs",
    "test:tooling:coverage": "c8 node --test --test-concurrency=2 \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/parser": "8.0.7",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@e2e-dev/web": "0.14.0",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@types/node": "26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "c8": "^12.0.0",
    "e2e": "0.19.0",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "semver": "7.8.5",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.7.0"
}
